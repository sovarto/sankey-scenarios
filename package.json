{
  "name": "my-react-router-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "db:generate": "dotenv -- drizzle-kit generate",
    "db:migrate": "dotenv -- drizzle-kit migrate",
    "db:migrate:test": "dotenv -e .env.test -- drizzle-kit migrate",
    "dev": "dotenv -- node server.js",
    "dev:test": "dotenv -e .env.test -- node server.js",
    "start": "node server.js",
    "typecheck": "react-router typegen && tsc -b",
    "prepare": "husky",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --cache --no-warn-ignored --cache-location .eslintcache --config eslint.config.js",
      "dprint fmt --config dprint.json --allow-no-files"
    ],
    "*.{json,md,markdown,yml,yaml,toml}": [
      "dprint fmt --config dprint.json --allow-no-files"
    ]
  },
  "dependencies": {
    "@react-router/express": "7.12.0",
    "@react-router/node": "7.12.0",
    "@types/d3": "^7.4.3",
    "compression": "^1.8.0",
    "d3": "^7.9.0",
    "drizzle-orm": "~0.36.3",
    "express": "^5.1.0",
    "isbot": "^5.1.27",
    "morgan": "^1.10.0",
    "postgres": "^3.4.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.12.0"
  },
  "devDependencies": {
    "@epic-web/config": "^1.16.4",
    "@playwright/test": "^1.58.2",
    "@react-router/dev": "7.12.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.1",
    "@types/express-serve-static-core": "^5.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20",
    "@types/pg": "^8.11.14",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^8.0.0",
    "dprint": "^0.50.1",
    "drizzle-kit": "~0.28.1",
    "eslint": "^8.38.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
